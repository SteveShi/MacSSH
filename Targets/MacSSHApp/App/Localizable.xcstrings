    "Local terminal sessions run detached in the background. Quitting the app or updating via Sparkle never kills your dev servers, builds, or scripts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local terminal sessions run detached in the background. Quitting the app or updating via Sparkle never kills your dev servers, builds, or scripts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地终端会话在后台解耦运行。退出 App 或通过 Sparkle 自动更新重启绝不会掐断正在运行的开发服务器、编译任务或脚本。"
          }
        }
      }
    },
